# Supply Chain QA - 生产环境变量
# 复制为 .env 并填写实际值
# 注意：所有 CHANGE_ME_* 占位符必须替换为强随机值，否则 docker-compose 会拒绝启动

# === 数据库密码（必填，无默认值）===
DB_USER=supply_chain_qa
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_NAME=supply_chain_qa
NEO4J_PASSWORD=CHANGE_ME_STRONG_NEO4J_PASSWORD

# === MinIO 对象存储（必填，无默认值）===
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD

# === JWT 签名密钥（必填，建议 openssl rand -hex 32 生成）===
JWT_SECRET=CHANGE_ME_RANDOM_64_HEX

# === 演示账号（生产环境保持 false）===
DEMO_SEED_USERS=false

# === 服务端口 ===
PORT=80
HTTPS_PORT=443

# === LLM 配置 ===
# 项目使用 llama.cpp 本地部署（Qwen2.5），通过 OpenAI 兼容接口调用
# DEEPSEEK_API_KEY 仅在调用远程 DeepSeek API 时需要，本地部署填 not-needed
DEEPSEEK_API_KEY=not-needed
DEEPSEEK_BASE_URL=http://localhost:8080/v1
DEEPSEEK_MODEL=qwen25
LLM_PROVIDER=deepseek

# === 前端 API 地址 ===
# 如果前后端同域名，用 /api
# 如果不同域名，用完整 URL
VITE_API_URL=/api

# === CORS（必填：指定具体域名，禁止使用 *）===
CORS_ORIGINS=https://your-domain.example.com

# === Reranker（需要 2GB+ 内存，小机器建议关闭）===
RERANKER_ENABLED=false

# === Langfuse 可观测（可选）===
# LANGFUSE_PUBLIC_KEY=pk-xxx
# LANGFUSE_SECRET_KEY=sk-xxx
# LANGFUSE_HOST=https://cloud.langfuse.com
