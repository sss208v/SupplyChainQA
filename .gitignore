# ============================
# Supply Chain QA - .gitignore
# ============================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
venv/
venv_wsl/
.venv/
env/

# ---- Coverage ----
htmlcov/
.coverage
coverage.xml

# ---- Node ----
node_modules/
.nuxt/
.output/
.vite/

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- Environment ----
.env
.env.local
.env.*.local

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini
nul

# ---- Logs ----
*.log
logs/

# ---- Docker volumes ----
pgdata/
redis-data/
milvus-data/

# ---- Uploads ----
uploads/*
!uploads/.gitkeep
backend/uploads/

# ---- Runtime user data & stray output dirs ----
/data/
backend/backend/

# ---- Test artifacts ----
test-results/
playwright-report/
frontend/tests/.auth/

# ---- Database ----
*.db
backend/app/data/supply_chain.db

# ---- Generated knowledge docs ----
knowledge/supply_chain_comprehensive_data_manual.md

# ---- Archive directories (iteration artifacts, not tracked) ----
_archive/
backend/_archive/
backend/eval/_archive/

# ---- Large binaries & models ----
llama.cpp-cuda13/
models/

# ---- Goal tracking / AI tool artifacts ----
.workbuddy/
.codegraph/
.claude/
.qoder/
.understand-anything/
.hermes/
.pytest_cache/
.agents/
.clawhub/
.hf_home/
skills/
plan/
docs/.agents/
docs/.codebuddy/
docs/.trae/
docs/.uploads/
docs/.workbuddy/
docs/skills-lock.json
GOAL_HERMES*.md
PROJECT_SUMMARY.md
TECHNICAL_DOCUMENTATION.md
DEMO_SCRIPT.md

# ---- Screenshots & misc ----
*.png
supply_chain_qa_cheatsheet.html
skills-lock.json

# ---- Misc exclusions ----
*.tmp
*.bak
*.cache
fix_chat*.py
demo_queries.json
scqa_e2e.js
test_permissions.ps1
rebuild_collection.py

# ---- One-off scratch scripts (underscore convention & dead codemods) ----
scripts/_*
backend/eval/_*
scripts/fix_dam_tfbs*.py
scripts/update_java_docs.py
scripts/rename_smartqa.py
scripts/integrate_onboarding_tab.py
