# ============================
# Supply Chain QA - .gitignore
# ============================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
venv/
venv_wsl/
.venv/
env/

# ---- Coverage ----
htmlcov/
.coverage
coverage.xml

# ---- Node ----
node_modules/
.nuxt/
.output/
.vite/

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- Environment ----
.env
.env.local
.env.*.local

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini
nul

# ---- Logs ----
*.log
logs/

# ---- Docker volumes ----
pgdata/
redis-data/
milvus-data/

# ---- Uploads ----
uploads/*
!uploads/.gitkeep
backend/uploads/

# ---- Runtime user data & stray output dirs ----
/data/
backend/backend/

# ---- Test artifacts ----
test-results/
playwright-report/
frontend/tests/.auth/

# ---- Database ----
*.db
backend/app/data/supply_chain.db

# ---- Generated knowledge docs ----
knowledge/supply_chain_comprehensive_data_manual.md

# ---- Archive directories (iteration artifacts, not tracked) ----
_archive/
backend/_archive/
backend/eval/_archive/

# ---- Large binaries & models ----
llama.cpp-cuda13/
models/

# ---- Misc exclusions ----
*.tmp
*.bak
*.cache
