# ============================================================
# Supply Chain QA - 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ============================================================

APP_NAME=Supply Chain QA
APP_VERSION=1.0.0
DEBUG=true
API_PREFIX=/api/v1

# ---- CORS 允许的前端来源（逗号分隔）----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_USER=supply_chain_qa
POSTGRES_PASSWORD=scqa1234
POSTGRES_DB=supply_chain_qa

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Milvus ----
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=supply_chain_qa_docs

# ---- 本地 LLM（llama.cpp OpenAI 兼容端点，项目默认；backend\scripts\start-llama-server.bat 启动）----
LOCAL_LLM_BASE_URL=http://localhost:18080/v1
LOCAL_LLM_MODEL=Qwen3-14B

# ---- DeepSeek API（云端可选，LLM_PROVIDER=deepseek 时启用）----
DEEPSEEK_API_KEY=***
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_FAST_MODEL=deepseek-chat

# ---- MiniMax API（Web 搜索 + 多模态图片理解）----
MINIMAX_API_KEY=your-minimax-key-here
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-M2.7

# ---- Ollama（本地模型推理）----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ---- Embedding ----
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=512

# ---- Reranker ----
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_ENABLED=false

# ---- RAG 参数 ----
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RRF_K=90
VECTOR_TOP_K=30
BM25_TOP_K=30
RERANK_TOP_K=8
CONFIDENCE_THRESHOLD=0.6
# RRF 权重等调优参数由 config.py 作为唯一真相来源。
# 如需覆盖，取消注释并设置期望值。
#RRF_BM25_WEIGHT_PRECISE=1.25
#RRF_VECTOR_WEIGHT_SEMANTIC=2.25
#RRF_BM25_WEIGHT_DEFAULT=1.75
#RRF_VECTOR_WEIGHT_DEFAULT=1.25
#RRF_MIN_SCORE=0.015
#GRAPH_FUSION_ALPHA=0.5
#GRAPH_FUSION_BETA=0.7

# ---- Memory ----
MEMORY_WINDOW=10
MEMORY_TTL=86400
SUMMARY_INTERVAL=10
SUMMARY_TRUNCATE_LEN=40

# ---- SSE ----
SSE_HEARTBEAT_INTERVAL=15

# ---- LLM（local / deepseek / ollama，项目默认本地 llama.cpp）----
LLM_PROVIDER=local

# ---- Agent ----
AGENT_TYPE=react

# ---- MCP 服务器（逗号分隔的 MCP server URLs）----
MCP_SERVERS=

# ---- 功能开关 ----
SELF_RAG_ENABLED=true
SELF_RAG_THRESHOLD=0.4
GUARDRAILS_ENABLED=false
FAITHFULNESS_ENABLED=true

# ---- CRAG（纠正式检索增强生成）----
CRAG_ENABLED=true
CRAG_MAX_RETRIES=1
CRAG_RELEVANCE_THRESHOLD=0.4

# ---- Demo 模式（无 LLM 时返回本地 fallback）----
DEMO_MODE=false
DEMO_SEED_USERS=true

# ---- Langfuse 可观测性（本地自托管，docker-compose 启动后可用）----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3100

# ---- JWT 认证 ----
JWT_SECRET=scqa-jwt-dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_SECONDS=86400

# ---- Neo4j 图数据库（实体关系图谱检索）----
NEO4J_URI=bolt://localhost:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=scqa1234

# ---- 图谱融合权重（α=向量+BM25, β=图谱）----
GRAPH_FUSION_ALPHA=0.5
GRAPH_FUSION_BETA=0.7

# ---- 认证边界 ----
# 对话接口是否强制登录（默认 true；本地演示可设 false 允许匿名对话）
REQUIRE_AUTH_CHAT=true
