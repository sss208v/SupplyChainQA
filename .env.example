# ============================================
# SmartQA Pro - 企业级智能问答助手系统
# ============================================

# ---- 应用配置 ----
APP_NAME=SmartQA
APP_VERSION=1.0.0
DEBUG=true
API_PREFIX=/api/v1

# ---- 数据库配置 ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=smartqa
POSTGRES_PASSWORD=smartqa123
POSTGRES_DB=smartqa

# ---- Redis配置 ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- Milvus配置 ----
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=smartqa_docs

# ---- 大模型配置 ----
# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Ollama本地模型
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ---- 嵌入模型配置 ----
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=1024

# ---- Reranker配置 ----
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu

# ---- 意图分类模型 ----
INTENT_MODEL=all-MiniLM-L6-v2

# ---- RAG参数 ----
CHUNK_SIZE=512
CHUNK_OVERLAP=64
VECTOR_TOP_K=20
BM25_TOP_K=20
RERANK_TOP_K=3
CONFIDENCE_THRESHOLD=0.7

# ---- 对话记忆 ----
MEMORY_WINDOW=10
MEMORY_TTL=86400

# ---- SSE配置 ----
SSE_HEARTBEAT_INTERVAL=15
