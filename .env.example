# ============================================================
# SmartQA Pro - 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ============================================================

APP_NAME=SmartQA
APP_VERSION=1.0.0
DEBUG=true
API_PREFIX=/api/v1

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_USER=smartqa
POSTGRES_PASSWORD=smartqa123
POSTGRES_DB=smartqa

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Milvus ----
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=smartqa_docs

# ---- DeepSeek API ----
DEEPSEEK_API_KEY=***
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_FAST_MODEL=deepseek-chat

# ---- MiniMax API（Web 搜索 + 多模态图片理解）----
MINIMAX_API_KEY=your-minimax-key-here
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-M2.7

# ---- Embedding ----
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=512

# ---- Reranker ----
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_ENABLED=false

# ---- RAG 参数 ----
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RRF_K=60
VECTOR_TOP_K=20
BM25_TOP_K=20
RERANK_TOP_K=3
CONFIDENCE_THRESHOLD=0.65

# ---- Memory ----
MEMORY_WINDOW=10
MEMORY_TTL=86400
SUMMARY_INTERVAL=10
SUMMARY_TRUNCATE_LEN=40

# ---- SSE ----
SSE_HEARTBEAT_INTERVAL=15

# ---- LLM ----
LLM_PROVIDER=deepseek

# ---- Agent ----
AGENT_TYPE=react

# ---- 功能开关 ----
SELF_RAG_ENABLED=true
GUARDRAILS_ENABLED=false
FAITHFULNESS_ENABLED=true

# ---- CLIP 多模态嵌入（图文混合检索）----
CLIP_ENABLED=false
CLIP_MODEL=openai/clip-vit-base-patch32
CLIP_IMAGE_COLLECTION=smartqa_images
CLIP_TOP_K=3
CLIP_DEVICE=cpu

# ---- Vision API（已弃用，保留配置）----
VISION_ENABLED=false
VISION_PROVIDER=minimax
VISION_MODEL=MiniMax-Vision-01
VISION_MAX_IMAGES=5

# ---- Neo4j 图数据库 ----
NEO4J_URI=bolt://localhost:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=smartqa123

# ---- 图谱融合权重 ----
GRAPH_FUSION_ALPHA=0.7
GRAPH_FUSION_BETA=0.3
